# ============================================================
#  Stray Animal Community Platform — environment template
#  Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

# ---- Database (Supabase: PostgreSQL + PostGIS) ----
# Use the DIRECT connection string from Supabase → Project Settings → Database
# (host db.<ref>.supabase.co, port 5432). Enable the PostGIS extension first.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Schemas searched for the PostGIS `geometry` type. Supabase installs PostGIS into a dedicated
# schema (e.g. `gis` or `extensions`) that is not on the default search_path — include it here.
DB_SEARCH_PATH=public,extensions,gis

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Gemini API (injury, edge-case species, anti-spam, dashboard insights) ----
# Free-tier key from https://aistudio.google.com/apikey (starts with "AIza")
GEMINI_API_KEY=your-gemini-api-key-here
# Free-tier multimodal model (gemini-1.5-* is retired; 2.0-flash is the current free flash).
GEMINI_MODEL=gemini-2.0-flash

# ---- Google Sign-In (optional) ----
# OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google Sign-In (the app falls back to email + password).
GOOGLE_CLIENT_ID=

# ---- Password reset email (optional) ----
# Frontend origin used to build the reset link that gets emailed.
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=15
# SMTP for sending reset emails. Leave blank to run in DEV mode: the reset endpoint returns the
# code/link in its response so the flow is testable without an email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SafeTails <no-reply@safetails.app>

# ---- ML inference ----
SPECIES_MODEL_PATH=ml/exported/species_model.onnx
# Empirical "Unverified" routing threshold T (set in Phase 2 calibration). Placeholder:
SPECIES_CONFIDENCE_THRESHOLD=0.70

# ---- App config ----
SEED=42
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=10
# Location generalisation grid size in metres (privacy)
LOCATION_GRID_METERS=100

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Kathmandu Valley default map centre
NEXT_PUBLIC_MAP_CENTER_LAT=27.7172
NEXT_PUBLIC_MAP_CENTER_LNG=85.3240
SPECIES_TEMPERATURE=0.8243

# Cloudinary image hosting (report photos + avatars). Empty falls back to local /uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
